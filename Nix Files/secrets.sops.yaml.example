# ==============================================================================
# NixOS Homelab Secrets SSoT (secrets.sops.yaml.example)
# ==============================================================================
# This is an unencrypted template showing the exact structure of your
# secrets.sops.yaml file. Copy this file to secrets.sops.yaml, populate
# the values, and encrypt it using `sops -e -i secrets.sops.yaml`.
#
# IMPORTANT: Under NO circumstances commit secrets.sops.yaml with raw values
# to git! Only secrets.sops.yaml (encrypted) or secrets.sops.yaml.example should
# be managed in version control.
# ==============================================================================

# ─── DOMAIN 10: NETWORKING & TAILSCALE ────────────────────────────────────────
# Tailscale pre-authorized login key for headless auto-joining
tailscale_token: "tskey-auth-REPLACE_ME_IN_SOPS_FILE"

# Privado VPN WireGuard private key allocated to your account
privado_private_key: "your_privado_wireguard_private_key_base64_here"

# ─── DOMAIN 30: STORAGE & CLOUD BACKUP ────────────────────────────────────────
# Restic cloud backup target password
restic_password: "super_secure_restic_repository_password"

# Restic S3 Cloud connection credentials (env variables format)
restic_s3_creds: |
  AWS_ACCESS_KEY_ID="your_s3_access_key_here"
  AWS_SECRET_ACCESS_KEY="your_s3_secret_access_key_here"
  RESTIC_REPOSITORY="s3:https://s3.your-provider.com/your-bucket-name"

# ─── DOMAIN 50: UNIFIED MEDIA ENGINE ─────────────────────────────────────────
# Media stack individual Application API keys (used for inter-app REST communication)
prowlarr_api_key: "prowlarr_hexadecimal_api_key_32_chars"
sonarr_api_key: "sonarr_hexadecimal_api_key_32_chars"
radarr_api_key: "radarr_hexadecimal_api_key_32_chars"
sabnzbd_api_key: "sabnzbd_hexadecimal_api_key_32_chars"

# Indexer external credentials
scenenzbs_api_key: "your_scenenzbs_com_index_api_key"

# SABnzbd Usenet Downloader Server Connection
sabnzbd_usenet_user: "your_newshosting_username_here"
sabnzbd_usenet_password: "your_newshosting_password_here"

# ─── DOMAIN 60: PRODUCTION APPLICATION LAYER ─────────────────────────────────
# Vaultwarden admin panel token for user management
vaultwarden_admin_token: "vaultwarden_admin_portal_secure_token"

# Mosquitto MQTT broker password for clients
mosquitto_password: "mosquitto_client_password_here"

# Pocket-ID encryption key and SMTP password
pocket_id_encryption_key: "pocket_id_encryption_key_base64_here"
pocket_id_smtp_pass: "pocket_id_smtp_password_here"

# Speedtest Tracker Laravel application key
speedtest_tracker_app_key: "speedtest_tracker_laravel_key_base64_here"

# Open-WebUI JWT signing secret and OpenAI API key
open_webui_secret_key: "open_webui_jwt_secret_key_here"
open_webui_openai_api_key: "open_webui_openai_api_key_here"

# Linkwarden NextAuth secret key
linkwarden_nextauth_secret: "linkwarden_jwt_secret_key_here"

# ─── DOMAIN 40: MONITORING & WATCHTOWER ───────────────────────────────────────
# Gatus SSH private key for local loopback checks
gatus_ssh_key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  your_gatus_private_key_here
  -----END OPENSSH PRIVATE KEY-----

# Gatus SSH public key for local loopback checks (authorized key file for monitoring user)
gatus_ssh_public_key: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx gatus-local-monitoring"

# CrowdSec Firewall Bouncer API Key
crowdsec_bouncer_key: "crowdsec_bouncer_api_key_32_chars"
